{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "tienda": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "npm run build:vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "tienda" } }
  ],
  "crons": [
    { "path": "/api/cron/mercado-pago", "schedule": "* * * * *" }
  ]
}
