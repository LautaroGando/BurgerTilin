DATABASE_URL=postgresql://tilin:CHANGE_ME@localhost:5432/burger_tilin
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
# Absolute path to persistent media storage; default: project .local/uploads
UPLOAD_DIR=
# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
NODE_ENV=development
# Required only when creating the first owner. Never reuse an example password.
OWNER_EMAIL=
OWNER_PASSWORD=
# Mercado Pago Checkout Pro con Orders. Requiere WEB_ORIGIN público con HTTPS.
# Solo para localhost con una cuenta de prueba. En producción se usan credenciales productivas.
MP_TEST_MODE=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SELLER_ID=
# Comisión estimada para reportes, en puntos básicos. 100 equivale al 1 %.
MP_FEE_BPS=0
